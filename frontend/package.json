{
  "name": "worthline",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"public/i18n/it.json\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"eslint.config.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"public/i18n/it.json\" \"e2e/**/*.ts\" \"playwright.config.ts\" \"eslint.config.mjs\"",
    "test:e2e": "playwright test"
  },
  "private": true,
  "packageManager": "npm@10.8.3",
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "date-fns": "^4.4.0",
    "decimal.js": "^10.6.0",
    "lossless-json": "^4.3.3",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.13.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "@angular/build": {
      "vite": "8.3.5"
    }
  }
}
